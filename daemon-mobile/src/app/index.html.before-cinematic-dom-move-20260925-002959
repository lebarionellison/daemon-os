<script>window.DAEMON_API_URL = "https://daemon-os.lebarionellison.workers.dev";</script>
<script>window.DaemonAuth = (() => {
  const API = window.DAEMON_API_URL || "";
  let mode = "register";

  const modal = () => document.getElementById("daemon-auth-modal");
  const status = () => document.getElementById("daemon-auth-status");

  function open(nextMode = "register") {
    mode = nextMode;
    document.getElementById("daemon-auth-title").textContent =
      mode === "login" ? "Welcome back" : "Start Daemon";
    document.getElementById("daemon-auth-subtitle").textContent =
      mode === "login" ? "Sign in to your Daemon OS account." : "Create your Daemon OS account.";
    document.getElementById("daemon-auth-submit").textContent =
      mode === "login" ? "Sign In" : "Create Account";
    document.getElementById("daemon-auth-name").style.display =
      mode === "login" ? "none" : "block";
    document.querySelector('label[for="daemon-auth-name"]').style.display =
      mode === "login" ? "none" : "block";
    document.getElementById("daemon-auth-switch-text").textContent =
      mode === "login" ? "Need an account?" : "Already have an account?";
    document.getElementById("daemon-auth-switch").textContent =
      mode === "login" ? "Create one" : "Sign in";
    status().textContent = "";
    modal().classList.add("active");
  }

  function close() {
    modal().classList.remove("active");
  }

  function toggle() {
    open(mode === "login" ? "register" : "login");
  }

  async function submit(event) {
    event.preventDefault();
    status().textContent = "Connecting to Daemon OSâ€¦";

    const body = {
      email: document.getElementById("daemon-auth-email").value.trim(),
      password: document.getElementById("daemon-auth-password").value
    };

    if (mode === "register") {
      body.name = document.getElementById("daemon-auth-name").value.trim();
    }

    try {
      const response = await fetch(
        API + (mode === "login" ? "/api/auth/login" : "/api/auth/register"),
        {
          method: "POST",
          credentials: "include",
          headers: {"Content-Type":"application/json"},
          body: JSON.stringify(body)
        }
      );

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.error || "Authentication failed");
      }

      status().style.color = "#6dffb0";
      status().textContent = "Connected. Opening Daemon OSâ€¦";

      setTimeout(async () => {
        close();

        const pendingPlan = sessionStorage.getItem("daemon_pending_plan");

        if (pendingPlan) {
          sessionStorage.removeItem("daemon_pending_plan");

          try {
            const checkoutResponse = await fetch(
              "https://daemon-os.lebarionellison.workers.dev/api/billing/checkout",
              {
                method: "POST",
                credentials: "include",
                headers: {"Content-Type":"application/json"},
                body: JSON.stringify({plan: pendingPlan})
              }
            );

            const checkoutData = await checkoutResponse.json().catch(() => ({}));

            if (!checkoutResponse.ok || !checkoutData.checkout_url) {
              throw new Error(
                checkoutData.message ||
                checkoutData.error ||
                "Unable to start checkout"
              );
            }

            window.location.href = checkoutData.checkout_url;
            return;
          } catch (error) {
            console.error("Daemon billing error:", error);
            alert("Your account was created, but checkout could not be opened. Please try again.");
            return;
          }
        }

        window.location.hash = "dashboard";
        window.location.reload();
      }, 500);
    } catch (error) {
      status().style.color = "#ff8295";
      status().textContent = error.message;
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("daemon-auth-form").addEventListener("submit", submit);

    document.querySelectorAll('a[href="#pricing"]').forEach(link => {
      link.addEventListener("click", () => {
        setTimeout(() => open("register"), 150);
      });
    });
  });

  return {open, close, toggle};
})();
</script>


<script id="daemon-manage-billing">
(function () {
  const button = document.getElementById("daemon-manage-billing");
  if (!button) return;

  button.addEventListener("click", async function () {
    const original = button.textContent;

    button.disabled = true;
    button.textContent = "OPENING...";

    try {
      const response = await fetch(
        "https://daemon-os.lebarionellison.workers.dev/api/billing/portal",
        {
          method: "POST",
          credentials: "include"
        }
      );

      const data = await response.json().catch(() => ({}));

      if (!response.ok || !data.portal_url) {
        if (response.status === 401) {
          throw new Error("Please sign in to manage your billing.");
        }

        throw new Error(
          data.message ||
          data.error ||
          "Unable to open billing portal."
        );
      }

      window.location.href = data.portal_url;
    } catch (error) {
      console.error("Daemon billing portal error:", error);
      alert(error.message || "Unable to open billing portal.");
      button.disabled = false;
      button.textContent = original;
    }
  });
})();
</script>
<script id="daemon-billing-buttons">
(function () {
  function startBilling(plan) {
    sessionStorage.setItem("daemon_pending_plan", plan);
    if (window.DaemonAuth && typeof window.DaemonAuth.open === "function") {
      window.DaemonAuth.open("register");
      return;
    }
    alert("Please create or sign in to your Daemon OS account first.");
  }

  document.addEventListener("click", function (event) {
    const button = event.target.closest("[data-daemon-plan]");
    if (!button) return;
    event.preventDefault();
    startBilling(button.dataset.daemonPlan);
  });

  document.querySelectorAll("a").forEach(function (link) {
    const text = link.textContent.trim().toLowerCase();

    if (text.includes("start personal")) {
      link.dataset.daemonPlan = "personal";
      link.removeAttribute("target");
      link.removeAttribute("rel");
      link.href = "#pricing";
    }

    if (text.includes("start pro")) {
      link.dataset.daemonPlan = "pro";
      link.removeAttribute("target");
      link.removeAttribute("rel");
    }

    if (text.includes("start business")) {
      link.dataset.daemonPlan = "business";
      link.removeAttribute("target");
      link.removeAttribute("rel");
    }
  });
})();
</script>

