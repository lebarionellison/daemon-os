(function(){
  const $=id=>document.getElementById(id);
  const API=window.DAEMON_API || "http://127.0.0.1:8787";

  function greet(){
    const h=new Date().getHours();
    $("dpc-greeting").textContent=(h<12?"Good morning.":h<18?"Good afternoon.":"Good evening.")+" Daemon is watching.";
    $("dpc-time").textContent=new Intl.DateTimeFormat([],{
      weekday:"short",month:"short",day:"numeric",hour:"numeric",minute:"2-digit",second:"2-digit"
    }).format(new Date());
  }
  setInterval(greet,1000); greet();

  function say(text){
    if("speechSynthesis" in window){
      speechSynthesis.cancel();
      const u=new SpeechSynthesisUtterance(text);
      u.rate=.95; u.pitch=1;
      speechSynthesis.speak(u);
    }
  }

  function command(text){
    text=text.toLowerCase().trim();
    $("dpc-command").textContent="Command: "+text;

    if(text.includes("alert")){
      $("dpc-alerts").scrollIntoView({behavior:"smooth",block:"center"});
      say("Opening your alerts.");
    }else if(text.includes("log")||text.includes("history")||text.includes("data")){
      $("dpc-logs").scrollIntoView({behavior:"smooth",block:"center"});
      say("Opening your personal logs.");
    }else if(text.includes("task")){
      $("dpc-task-input").focus();
      say("Ready for your task.");
    }else if(text.includes("status")||text.includes("health")){
      const s=$("dpc-status").textContent;
      const c=$("dpc-cpu").textContent;
      const m=$("dpc-memory").textContent;
      say("Daemon reports "+s+". CPU is "+c+". Memory is "+m+".");
    }else if(text.includes("first")||text.includes("detection")){
      $("dpc-detection").scrollIntoView({behavior:"smooth",block:"center"});
      say("Opening first detection.");
    }else{
      say("I heard "+text+". Try system status, show alerts, show logs, or add task.");
    }
  }

  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(SR){
    const r=new SR();
    r.lang=navigator.language||"en-US";
    r.interimResults=false;
    r.continuous=false;
    r.onstart=()=>{$("dpc-voice").classList.add("listening");$("dpc-voice").textContent="?  LISTENINGâ€¦";};
    r.onend=()=>{$("dpc-voice").classList.remove("listening");$("dpc-voice").textContent="?  VOICE COMMAND";};
    r.onerror=()=>{$("dpc-command").textContent="Voice input unavailable or permission was denied.";};
    r.onresult=e=>command(e.results[0][0].transcript);
    $("dpc-voice").onclick=()=>{try{r.start()}catch(e){}};
  }else{
    $("dpc-voice").onclick=()=>{$("dpc-command").textContent="Voice commands require a browser with Speech Recognition support.";};
  }

  function renderTasks(){
    const tasks=JSON.parse(localStorage.getItem("daemonTasks")||"[]");
    $("dpc-tasks").innerHTML=tasks.length?tasks.map((t,i)=>
      '<div class="dpc-task"><input type="checkbox" data-i="'+i+'" '+(t.done?"checked":"")+'><span style="'+(t.done?"text-decoration:line-through;opacity:.45":"")+'">'+
      String(t.text).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))+'</span></div>'
    ).join(""):'<div class="dpc-log">No active tasks.</div>';
    $("dpc-tasks").querySelectorAll("input").forEach(x=>x.onchange=()=>{
      const a=JSON.parse(localStorage.getItem("daemonTasks")||"[]");a[+x.dataset.i].done=x.checked;localStorage.setItem("daemonTasks",JSON.stringify(a));renderTasks();
    });
  }
  $("dpc-task-add").onclick=()=>{
    const input=$("dpc-task-input"),text=input.value.trim();if(!text)return;
    const a=JSON.parse(localStorage.getItem("daemonTasks")||"[]");a.unshift({text,done:false,time:new Date().toISOString()});
    localStorage.setItem("daemonTasks",JSON.stringify(a));input.value="";renderTasks();say("Task added.");
  };
  $("dpc-task-input").onkeydown=e=>{if(e.key==="Enter")$("dpc-task-add").click()};
  renderTasks();

  function text(v){
    if(v===null||v===undefined||v==="")return "--";
    return typeof v==="number"?v.toFixed(1)+"%":String(v);
  }

  async function json(endpoint){
    try{const r=await fetch(API+endpoint,{cache:"no-store"});if(!r.ok)throw 0;return await r.json()}catch(e){return null}
  }

  async function refresh(){
    const t=await json("/telemetry");
    if(t){
      $("dpc-cpu").textContent=text(t.cpu_usage);
      $("dpc-memory").textContent=text(t.memory_used_percent??t.memory_usage);
      $("dpc-disk").textContent=text(t.disk_used_percent??t.disk_usage);
      $("dpc-uptime").textContent=t.uptime??"--";
      $("dpc-status").textContent="Online";
    }

    const s=await json("/security");
    if(s){
      const level=s.status??s.level??s.score??"Monitoring";
      $("dpc-status").textContent=String(level);
    }

    const h=await json("/history");
    if(h){
      const events=Array.isArray(h)?h:(h.events||h.history||h.data||[]);
      if(events.length){
        const first=events[0];
        const last=events.slice(-4).reverse();
        $("dpc-detection").innerHTML='<div class="dpc-card dpc-detection"><div style="font-size:11px;font-weight:700">'+
          String(first.event||first.message||first.type||"First detection").replace(/[<>]/g,"")+
          '</div><div class="dpc-log">'+String(first.timestamp||first.time||first.created_at||"Recorded by Daemon")+'</div></div>';
        $("dpc-logs").innerHTML=last.map(e=>'<div class="dpc-card dpc-log">'+
          '<strong>'+String(e.event||e.type||"Event").replace(/[<>]/g,"")+'</strong><br>'+
          String(e.message||e.description||e.value||"Daemon recorded system activity.").replace(/[<>]/g,"")+
          '<br><span style="opacity:.55">'+String(e.timestamp||e.time||"recent")+'</span></div>').join("");
      }
    }

    const i=await json("/intelligence");
    if(i){
      const alerts=i.alerts||i.anomalies||i.events;
      if(Array.isArray(alerts)&&alerts.length){
        $("dpc-alerts").innerHTML=alerts.slice(0,4).map(a=>'<div class="dpc-card dpc-alert dpc-log">'+
          String(a.message||a.title||a.type||a).replace(/[<>]/g,"")+'</div>').join("");
      }
    }
  }

  refresh();
  setInterval(refresh,5000);
})();
</script><style id="daemon-proactive-intelligence">
