    const t=document.getElementById("hero-trend");
    const d=document.getElementById("intel-history");
    if(h) health=parseFloat(h.textContent)||100;
    if(a) anomaly=/true|detected|yes/i.test(a.textContent);
    if(t) trend=(t.textContent||"STABLE").trim().toUpperCase();
    if(d && /disk/i.test(d.textContent)) dominant="STORAGE";
    else if(d && /memory/i.test(d.textContent)) dominant="MEMORY";
    else if(d && /cpu/i.test(d.textContent)) dominant="CPU";
  }

  function draw(){
    readState();
    ctx.clearRect(0,0,w,h);

    const activity=Math.max(.12,1-health/100);
    const pulse=1+Math.sin(Date.now()/500)*.08;
    const ox=(mx-.5)*18, oy=(my-.5)*18;

    const pts=nodes.map(n=>({
      x:n.x*w+ox,
      y:n.y*h+oy
    }));

    ctx.lineWidth=1;
    ctx.globalAlpha=.18+activity*.2;

    pts.forEach((p,i)=>{
      pts.forEach((q,j)=>{
        if(j<=i)return;
        const dist=Math.hypot(p.x-q.x,p.y-q.y);
        if(dist<650){
          ctx.beginPath();
          ctx.moveTo(p.x,p.y);
          ctx.lineTo(q.x,q.y);
          ctx.stroke();
        }
      });
    });

    const center=pts[4];
    const glow=anomaly?80:trend==="WORSENING"?55:35;
    const g=ctx.createRadialGradient(center.x,center.y,0,center.x,center.y,glow*pulse);
    g.addColorStop(0,"rgba(255,255,255,.16)");
    g.addColorStop(1,"rgba(255,255,255,0)");
    ctx.fillStyle=g;
    ctx.beginPath();
    ctx.arc(center.x,center.y,glow*pulse,0,Math.PI*2);
    ctx.fill();

    pts.forEach((p,i)=>{
      const r=i===4?5:3;
      ctx.globalAlpha=.25+activity*.35;
      ctx.beginPath();
      ctx.arc(p.x,p.y,r+(i===4?activity*4:0),0,Math.PI*2);
      ctx.fill();
    });

    ctx.globalAlpha=.14;
    ctx.font="10px system-ui";
    ctx.letterSpacing="2px";
    nodes.forEach((n,i)=>{
      if(i===4 || health<90){
        ctx.fillText(n.label,pts[i].x+10,pts[i].y-8);
      }
    });

    if(anomaly || trend==="WORSENING"){
      ctx.globalAlpha=.08;
      for(let i=0;i<4;i++){
        const p=pts[i];
        const q=center;
        ctx.beginPath();
        ctx.arc(p.x+(q.x-p.x)*((Date.now()/1800)%1),
                p.y+(q.y-p.y)*((Date.now()/1800)%1),2,0,Math.PI*2);
        ctx.fill();
      }
    }

    requestAnimationFrame(draw);
  }
  draw();
})();
