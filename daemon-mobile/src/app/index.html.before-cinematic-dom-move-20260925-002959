<script id="daemon-proactive-intelligence">
(()=>{
 const API=window.DAEMON_API || "http://127.0.0.1:8787";
 const LOGKEY="daemonPersonalLog";
 const SNAPKEY="daemonPersonalSnapshot";
 const $=id=>document.getElementById(id);

 const consoleBox=$("daemon-personal-console");
 if(!consoleBox)return;

 const existing=$("dpc-insight");
 if(!existing){
   const card=document.createElement("div");
   card.id="dpc-insight";
   card.innerHTML='<div id="dpc-insight-label">DAEMON INSIGHT</div><div id="dpc-insight-text">Daemon is establishing your personal system baselineâ€¦</div><div id="dpc-insight-meta">Watching telemetry, security, history and intelligence.</div>';
   const greeting=$("dpc-greeting");
   if(greeting && greeting.parentNode) greeting.parentNode.insertBefore(card,greeting.nextSibling);
 }

 const activity=document.createElement("div");
 activity.id="dpc-activity";
 activity.innerHTML='<div id="dpc-activity-title" style="font-size:9px;letter-spacing:.15em;opacity:.55;margin-bottom:5px">PERSONAL ACTIVITY</div>';
 const logs=$("dpc-logs");
 if(logs && logs.parentNode) logs.parentNode.insertBefore(activity,logs);

 function read(key,fallback){try{return JSON.parse(localStorage.getItem(key))||fallback}catch{return fallback}}
 function write(key,value){try{localStorage.setItem(key,JSON.stringify(value))}catch{}}

 let snapshot=read(SNAPKEY,null);
 let events=read(LOGKEY,[]);

 function time(){
   return new Date().toLocaleTimeString([], {hour:"numeric",minute:"2-digit"});
 }

 function addEvent(text,type="system"){
   const item={text,type,time:new Date().toISOString()};
   events=[item,...events].slice(0,30);
   write(LOGKEY,events);
   renderEvents();
 }

 function renderEvents(){
   if(!activity)return;
   const recent=events.slice(0,5);
   activity.innerHTML='<div id="dpc-activity-title" style="font-size:9px;letter-spacing:.15em;opacity:.55;margin-bottom:5px">PERSONAL ACTIVITY</div>'+
     (recent.length?recent.map(e=>'<div class="dpc-activity"><strong>'+escapeHtml(e.text)+'</strong><time>'+new Date(e.time).toLocaleTimeString([], {hour:"numeric",minute:"2-digit"})+'</time></div>').join(""):'<div class="dpc-activity">No activity recorded yet.</div>');
 }

 function escapeHtml(v){
   return String(v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
 }

 function insight(text,meta="",attention=false){
   const t=$("dpc-insight-text"),m=$("dpc-insight-meta"),box=$("dpc-insight");
   if(t)t.textContent=text;
   if(m)m.textContent=meta;
   if(box)box.classList.toggle("dpc-attention",attention);
 }

 function setVoice(text){
   if($("dpc-command"))$("dpc-command").textContent=text;
 }

 function speak(text){
   if("speechSynthesis" in window){
     speechSynthesis.cancel();
     speechSynthesis.speak(new SpeechSynthesisUtterance(text));
   }
 }

 async function json(path){
   try{
     const r=await fetch(API+path,{cache:"no-store"});
     if(!r.ok)throw new Error(path);
     return await r.json();
   }catch{return null}
 }

 async function monitor(){
   const [telemetry,security,intelligence,history]=await Promise.all([
     json("/telemetry"),json("/security"),json("/intelligence"),json("/history")
   ]);

   if(!telemetry)return;

   const cpu=Number(telemetry.cpu_usage??0);
   const mem=Number(telemetry.memory_used_percent??telemetry.memory_usage??0);
   const disk=Number(telemetry.disk_used_percent??telemetry.disk_usage??0);

   let attention=[];
   if(cpu>=90)attention.push("CPU is running very high");
   if(mem>=90)attention.push("memory usage is very high");
   if(disk>=90)attention.push("disk capacity is critically high");

   const securityText=JSON.stringify(security||{}).toLowerCase();
   if(securityText.includes("critical")||securityText.includes("threat")||securityText.includes("alert"))attention.push("security activity needs review");

   const current={cpu,mem,disk,security:securityText};

   if(snapshot){
     if(snapshot.cpu<80 && cpu>=80)addEvent("CPU crossed 80% â€” Daemon detected a meaningful change.","telemetry");
     if(snapshot.mem<80 && mem>=80)addEvent("Memory crossed 80% â€” Daemon detected a meaningful change.","telemetry");
     if(snapshot.disk<90 && disk>=90)addEvent("Disk usage crossed 90% â€” Daemon detected a capacity risk.","telemetry");
     if(snapshot.security!==securityText && securityText)addEvent("Security state changed â€” Daemon recorded the change.","security");
   }

   snapshot=current;
   write(SNAPKEY,snapshot);

   if(attention.length){
     insight("Needs your attention: "+attention[0],attention.length>1?attention.length+" active signals detected":"Daemon detected a meaningful system condition.",true);
   }else{
     const last=events[0];
     insight(last?"Nothing urgent. Latest: "+last.text:"Your system is being watched continuously.","Live telemetry and system intelligence are active.",false);
   }

   if($("dpc-status"))$("dpc-status").textContent=attention.length?"ATTENTION":"HEALTHY";
   if($("dpc-cpu"))$("dpc-cpu").textContent=cpu.toFixed(1)+"%";
   if($("dpc-memory"))$("dpc-memory").textContent=mem.toFixed(1)+"%";
   if($("dpc-disk"))$("dpc-disk").textContent=disk.toFixed(1)+"%";

   if(history){
     const raw=JSON.stringify(history);
     if(snapshot.lastHistoryHash && snapshot.lastHistoryHash!==raw){
       addEvent("New operational history detected.","history");
     }
     snapshot.lastHistoryHash=raw;
     write(SNAPKEY,snapshot);
   }

   renderEvents();
 }

 window.DaemonPersonalIntelligence={
   attention:async()=>{
     await monitor();
     const text=$("dpc-insight-text")?.textContent||"Daemon has no immediate attention items.";
     setVoice(text); speak(text);
   },
   status:async()=>{
     await monitor();
     const text="System status: "+($("dpc-status")?.textContent||"unknown")+
       ". CPU "+($("dpc-cpu")?.textContent||"unknown")+
       ". Memory "+($("dpc-memory")?.textContent||"unknown")+
       ". Disk "+($("dpc-disk")?.textContent||"unknown")+".";
     setVoice(text); speak(text);
   },
   activity:()=>{
     const text=events.length?"Latest activity: "+events[0].text:"There is no personal activity recorded yet.";
     setVoice(text);speak(text);
   },
   clearCompleted:()=>{
     try{
       const tasks=JSON.parse(localStorage.getItem("daemonTasks")||"[]");
       const remaining=Array.isArray(tasks)?tasks.filter(t=>!t.done&&!t.completed):[];
       localStorage.setItem("daemonTasks",JSON.stringify(remaining));
       if(typeof window.DaemonPersonalConsoleRefresh==="function")window.DaemonPersonalConsoleRefresh();
       setVoice("Completed tasks cleared.");
       speak("Completed tasks cleared.");
     }catch{}
   }
 };

 const originalCommand=$("dpc-command");
 if(originalCommand && !window.DaemonPersonalVoiceEnhanced){
   window.DaemonPersonalVoiceEnhanced=true;
   originalCommand.dataset.personalEnhanced="true";
 }

 const oldRecognition=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(oldRecognition){
   const voiceButton=$("dpc-voice");
   if(voiceButton){
     voiceButton.addEventListener("click",()=>{
       const recognition=new oldRecognition();
       recognition.lang="en-US";
       recognition.interimResults=false;
       recognition.maxAlternatives=1;
       recognition.onstart=()=>setVoice("Listeningâ€¦");
       recognition.onerror=()=>setVoice("Voice command unavailable. Try again.");
       recognition.onresult=e=>{
         const command=e.results[0][0].transcript.toLowerCase();
         setVoice('Heard: "'+command+'"');
         if(command.includes("what changed")||command.includes("attention")||command.includes("needs my"))DaemonPersonalIntelligence.attention();
         else if(command.includes("status")||command.includes("how is my system")||command.includes("health"))DaemonPersonalIntelligence.status();
         else if(command.includes("activity")||command.includes("personal logs")||command.includes("my logs"))DaemonPersonalIntelligence.activity();
         else if(command.includes("clear completed"))DaemonPersonalIntelligence.clearCompleted();
         else if(command.includes("read alerts")){const t=$("dpc-alerts")?.textContent||"No alerts.";speak(t)}
         else if(command.includes("first detection")){const t=$("dpc-detection")?.textContent||"No first detection available.";speak(t)}
         else speak("I heard "+command+", but I do not have an action for that command yet.");
       };
       recognition.start();
     });
   }
 }

 renderEvents();
 monitor();
 setInterval(monitor,8000);
})();
</script>

