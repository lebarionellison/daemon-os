<script id="daemon-persistent-production-ticker-js">
(function(){

  if(document.getElementById("daemon-production-ticker")){
    return;
  }

  const ticker = document.createElement("div");

  ticker.id = "daemon-production-ticker";

  ticker.innerHTML = `
    <div class="daemon-ticker-left">

      <div class="daemon-ticker-brand">
        <span class="daemon-ticker-dot"></span>
        DAEMON OS
      </div>

      <div class="daemon-ticker-status" id="daemon-ticker-status">
        CONNECTING
      </div>

      <div class="daemon-ticker-divider"></div>

      <div class="daemon-ticker-item">
        HOME <strong id="daemon-ticker-home">--</strong>
      </div>

      <div class="daemon-ticker-item">
        API <strong id="daemon-ticker-api">--</strong>
      </div>

      <div class="daemon-ticker-item">
        FAILURES <strong id="daemon-ticker-failures">--</strong>
      </div>

    </div>

    <div class="daemon-ticker-right">

      <div class="daemon-ticker-item">
        MONITORED <strong id="daemon-ticker-monitored">--</strong>
      </div>

      <div class="daemon-ticker-divider"></div>

      <div class="daemon-ticker-time" id="daemon-ticker-time">
        CHECK --
      </div>

    </div>
  `;

  document.body.appendChild(ticker);

  async function refreshProductionTicker(){

    try{

      const response = await fetch(
        "https://daemon-os-monitor.lebarionellison.workers.dev/status",
        {
          cache:"no-store"
        }
      );

      if(!response.ok){
        throw new Error("monitor unavailable");
      }

      const data = await response.json();

      const status =
        document.getElementById("daemon-ticker-status");

      const home =
        document.getElementById("daemon-ticker-home");

      const api =
        document.getElementById("daemon-ticker-api");

      const failures =
        document.getElementById("daemon-ticker-failures");

      const monitored =
        document.getElementById("daemon-ticker-monitored");

      const time =
        document.getElementById("daemon-ticker-time");

      if(status){
        status.textContent =
          data.status === "OPERATIONAL"
            ? "OPERATIONAL"
            : (data.status || "DEGRADED");
      }

      const targets = Array.isArray(data.targets)
        ? data.targets
        : [];

      const homepage = targets.find(
        item => item.target === "homepage"
      );

      const apiHealth = targets.find(
        item => item.target === "api-health"
      );

      if(home){
        home.textContent =
          homepage && homepage.healthy
            ? "200"
            : String(homepage?.status_code ?? "--");
      }

      if(api){
        api.textContent =
          apiHealth && apiHealth.healthy
            ? "200"
            : String(apiHealth?.status_code ?? "--");
      }

      if(failures){
        failures.textContent =
          String(data.consecutive_failures ?? 0);
      }

      if(monitored){
        monitored.textContent =
          String(targets.length || 2);
      }

      if(time && data.checked_at){

        const checked =
          new Date(data.checked_at);

        time.textContent =
          "CHECK " +
          checked.toLocaleTimeString([],{
            hour:"2-digit",
            minute:"2-digit",
            second:"2-digit"
          });
      }

    }catch(error){

      const status =
        document.getElementById("daemon-ticker-status");

      if(status){
        status.textContent = "MONITORING";
      }
    }
  }

  refreshProductionTicker();

  setInterval(
    refreshProductionTicker,
    30000
  );

})();
</script>

