</style><script id="daemon-live-production-sonar-script">
(function(){
  const monitorApi = "https://daemon-os-monitor.lebarionellison.workers.dev";

  const q = id => document.getElementById(id);

  const nodes = Array.from(
    document.querySelectorAll("#daemon-live-production .daemon-sonar-node")
  );

  function setNode(node, healthy, value, meta){
    const dot = node.querySelector("span");

    if(dot){
      dot.style.background = healthy ? "#63ffc1" : "#ff8295";
      dot.style.boxShadow = healthy
        ? "0 0 0 5px rgba(99,255,193,.06),0 0 18px rgba(99,255,193,.8)"
        : "0 0 0 5px rgba(255,130,149,.06),0 0 18px rgba(255,130,149,.8)";
    }

    node.dataset.value = value || "";
    node.dataset.meta = meta || "";
  }

  function renderMonitor(data){
    if(!data)return;

    const targets = Array.isArray(data.targets) ? data.targets : [];
    const healthy = targets.filter(t => t && t.healthy).length;

    q("daemon-production-status").textContent =
      String(data.status || "UNKNOWN").toUpperCase();

    q("daemon-production-updated").textContent =
      data.checked_at
        ? "Checked " + new Date(data.checked_at).toLocaleTimeString()
        : "Live monitor";

    q("daemon-live-status").textContent =
      String(data.status || "UNKNOWN").toUpperCase();

    q("daemon-live-monitored").textContent =
      healthy + "/" + targets.length;

    q("daemon-live-failures").textContent =
      String(data.consecutive_failures ?? 0);

    q("daemon-live-duration").textContent =
      data.check_duration_ms != null
        ? data.check_duration_ms + "ms"
        : "--";

    q("daemon-sonar-check").textContent =
      data.checked_at
        ? "UPDATED " + new Date(data.checked_at).toLocaleTimeString()
        : "LIVE";

    targets.forEach(target => {
      const node = nodes.find(
        n => n.dataset.target === target.target
      );

      if(!node)return;

      setNode(
        node,
        !!target.healthy,
        target.status_code != null
          ? target.status_code + " Â· " + (target.response_time_ms ?? "--") + "ms"
          : "UNAVAILABLE",
        target.healthy ? "Healthy production target" : "Production target unavailable"
      );
    });
  }

  async function refreshMonitor(){
    try{
      const response = await fetch(
        monitorApi + "/status",
        {
          cache:"no-store",
          mode:"cors"
        }
      );

      if(!response.ok)throw new Error("monitor " + response.status);

      renderMonitor(await response.json());

    }catch(error){
      q("daemon-production-status").textContent = "MONITOR OFFLINE";
      q("daemon-production-updated").textContent = "Unable to read live monitor";
      q("daemon-live-status").textContent = "UNAVAILABLE";
    }
  }

  nodes.forEach(node => {
    function show(){
      q("daemon-sonar-tooltip-title").textContent =
        node.querySelector("label")?.textContent || "PRODUCTION TARGET";

      q("daemon-sonar-tooltip-value").textContent =
        node.dataset.value || "Watching production";

      q("daemon-sonar-tooltip-meta").textContent =
        node.dataset.meta || "Live infrastructure state";
    }

    node.addEventListener("mouseenter",show);
    node.addEventListener("focus",show);
    node.addEventListener("click",show);
  });

  refreshMonitor();
  setInterval(refreshMonitor,30000);
})();
</script></body>
