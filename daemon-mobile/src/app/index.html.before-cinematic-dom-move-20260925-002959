<script id="daemon-live-intelligence-script">
(function(){

  const rail = document.getElementById("daemon-live-intelligence-rail");
  if(!rail || rail.dataset.initialized === "true") return;

  rail.dataset.initialized = "true";

  const API =
    window.DAEMON_API_URL ||
    window.DAEMON_API ||
    window.location.origin;

  const $ = id => document.getElementById(id);

  const state = {
    telemetry: null,
    intelligence: null,
    security: null,
    history: null,
    monitor: null,
    incident: null,
    values: []
  };

  function number(value, fallback = 0){
    const n = Number(value);
    return Number.isFinite(n) ? n : fallback;
  }

  function clamp(value,min,max){
    return Math.min(max,Math.max(min,value));
  }

  function text(value,fallback = "--"){
    if(value === null || value === undefined || value === ""){
      return fallback;
    }

    return String(value);
  }

  function escapeValue(value){
    return String(value)
      .replace(/[&<>"]/g,function(char){
        return {
          "&":"&amp;",
          "<":"&lt;",
          ">":"&gt;",
          "\"":"&quot;"
        }[char];
      });
  }

  async function json(endpoint){
    try{
      const response = await fetch(
        API + endpoint,
        {
          cache:"no-store",
          credentials:"include"
        }
      );

      if(!response.ok){
        throw new Error(endpoint);
      }

      return await response.json();
    }catch{
      return null;
    }
  }

  const MONITOR_API =
    "https://daemon-os-monitor.lebarionellison.workers.dev";

  async function monitorStatus(){
    try{
      const response = await fetch(
        MONITOR_API + "/status",
        {
          cache:"no-store",
          mode:"cors"
        }
      );

      if(!response.ok){
        throw new Error("monitor");
      }

      return await response.json();
    }catch{
      return null;
    }
  }

  function monitorTarget(monitor,name){
    if(!monitor || !Array.isArray(monitor.targets)){
      return null;
    }

    return monitor.targets.find(
      target => target.target === name
    ) || null;
  }

  function monitorAge(value){
    const timestamp = Date.parse(value);

    if(!Number.isFinite(timestamp)){
      return "--";
    }

    const seconds = Math.max(
      0,
      Math.floor((Date.now() - timestamp) / 1000)
    );

    if(seconds < 60){
      return seconds + "s ago";
    }

    const minutes = Math.floor(seconds / 60);

    if(minutes < 60){
      return minutes + "m ago";
    }

    return Math.floor(minutes / 60) + "h ago";
  }

  function extractAlerts(data){
    if(!data) return [];

    const candidates = [
      data.alerts,
      data.anomalies,
      data.events,
      data.threats,
      data.findings,
      data.data
    ];

    for(const candidate of candidates){
      if(Array.isArray(candidate) && candidate.length){
        return candidate;
      }
    }

    return [];
  }

  function historyItems(data){
    if(!data) return [];

    if(Array.isArray(data)){
      return data;
    }

    const candidates = [
      data.events,
      data.history,
      data.data,
      data.items
    ];

    for(const candidate of candidates){
      if(Array.isArray(candidate)){
        return candidate;
      }
    }

    return [];
  }

  function securityHasAttention(data){
    if(!data) return false;

    const raw = JSON.stringify(data).toLowerCase();

    return (
      raw.includes("critical") ||
      raw.includes("threat") ||
      raw.includes("alert") ||
      raw.includes("high")
    );
  }

  function calculateHealth(cpu,mem,disk,attention){
    const resourcePenalty =
      Math.max(0,cpu - 65) * .22 +
      Math.max(0,mem - 70) * .22 +
      Math.max(0,disk - 75) * .12;

    const securityPenalty = attention ? 12 : 0;

    return Math.round(
      clamp(
        100 - resourcePenalty - securityPenalty,
        0,
        100
      )
    );
  }

  function updateMetric(id,value){
    const element = $(id);

    if(element){
      element.textContent = value;
    }
  }

  function setTicker(id,value){
    const element = $(id);

    if(element){
      element.textContent = value;
    }
  }

  function updateTickerPairs(id,value){
    setTicker(id,value);
    setTicker(id + "-copy",value);
  }

  function setAttentionVisual(attention){
    const stateEl = $("daemon-live-state");
    const incident = $("daemon-live-incident");
    const severity = $("daemon-live-severity");

    if(stateEl){
      stateEl.classList.toggle("attention",attention);
    }

    if(incident){
      incident.classList.toggle("daemon-live-attention",attention);
    }

    if(severity){
      severity.textContent = attention ? "ATTENTION" : "WATCHING";
    }
  }

  function updateChart(value){
    const safe = clamp(number(value,0),0,100);

    state.values.push(safe);

    if(state.values.length > 32){
      state.values.shift();
    }

    if(state.values.length < 3){
      return;
    }

    const width = 700;
    const height = 100;

    const points = state.values.map(function(item,index){

      const x =
        index *
        (width / Math.max(1,state.values.length - 1));

      const y =
        height -
        ((item / 100) * 62 + 18);

      return [
        Math.round(x),
        Math.round(y)
      ];

    });

    let path = "M" + points[0][0] + " " + points[0][1];

    for(let i=1;i<points.length;i++){

      const previous = points[i - 1];
      const current = points[i];

      const midX =
        Math.round((previous[0] + current[0]) / 2);

      path +=
        " C" +
        midX + " " + previous[1] +
        " " +
        midX + " " + current[1] +
        " " +
        current[0] + " " + current[1];
    }

    const line = $("daemon-live-chart-line");
    const glow = $("daemon-live-chart-glow");

    if(line){
      line.setAttribute("d",path);
    }

    if(glow){
      glow.setAttribute("d",path);
    }
  }

  function buildIncident(alerts,cpu,mem,disk,securityAttention){

    let incident = null;

    if(alerts.length){

      const first = alerts[0];

      incident = {
        type:"intelligence",
        title:
          text(
            first.title ||
            first.message ||
            first.type,
            "Daemon detected an intelligence signal."
          ),
        copy:
          text(
            first.description ||
            first.message ||
            first.value,
            "Daemon detected a signal that warrants investigation."
          )
      };

    }else if(securityAttention){

      incident = {
        type:"security",
        title:"Security activity needs review.",
        copy:
          "Daemon detected security-related activity in the live security state."
      };

    }else if(cpu >= 90){

      incident = {
        type:"telemetry",
        title:"CPU utilization is critically high.",
        copy:
          "Live telemetry crossed the 90% CPU threshold."
      };

    }else if(mem >= 90){

      incident = {
        type:"telemetry",
        title:"Memory utilization is critically high.",
        copy:
          "Live telemetry crossed the 90% memory threshold."
      };

    }else if(disk >= 90){

      incident = {
        type:"telemetry",
        title:"Disk utilization is critically high.",
        copy:
          "Live telemetry crossed the 90% disk threshold."
      };
    }

    return incident;
  }

  function renderIncident(incident){

    const stateEl = $("daemon-live-incident-state");
    const title = $("daemon-live-incident-title");
    const copy = $("daemon-live-incident-copy");
    const investigate = $("daemon-live-investigate");
    const resolve = $("daemon-live-resolve");
    const analysis = $("daemon-live-analysis");
    const bug = $("daemon-live-bug");

    if(!incident){

      if(stateEl){
        stateEl.textContent = "NO ACTIVE INCIDENT";
      }

      if(title){
        title.textContent =
          "Infrastructure is being watched.";
      }

      if(copy){
        copy.textContent =
          "Daemon is continuously comparing live system signals with current infrastructure state.";
      }

      if(analysis){
        analysis.textContent =
          "No immediate attention signal detected.";
      }

      if(investigate){
        investigate.disabled = true;
      }

      if(resolve){
        resolve.disabled = true;
      }

      if(bug){
        bug.setAttribute(
          "aria-label",
          "No active Daemon alert"
        );
      }

      return;
    }

    state.incident = incident;

    if(stateEl){
      stateEl.textContent = "ACTIVE SIGNAL";
    }

    if(title){
      title.textContent = incident.title;
    }

    if(copy){
      copy.textContent = incident.copy;
    }

    if(analysis){
      analysis.textContent =
        "Daemon has an active signal ready for investigation.";
    }

    if(investigate){
      investigate.disabled = false;
    }

    if(resolve){
      resolve.disabled = true;
    }

    if(bug){
      bug.setAttribute(
        "aria-label",
        "Open active Daemon alert"
      );
    }
  }

  async function refresh(){

    const results = await Promise.all([
      json("/telemetry"),
      json("/security"),
      json("/intelligence"),
      json("/history"),
      monitorStatus()
    ]);

    state.telemetry = results[0];
    state.security = results[1];
    state.intelligence = results[2];
    state.history = results[3];
    state.monitor = results[4];

    const telemetry = state.telemetry;

    if(!telemetry){

      const stateText = $("daemon-live-state-text");

      if(stateText){
        stateText.textContent = "OFFLINE";
      }

      updateTickerPairs(
        "ticker-telemetry",
        "unavailable"
      );

      return;
    }

    const cpu = number(
      telemetry.cpu_usage ??
      telemetry.cpu ??
      telemetry.cpu_percent,
      0
    );

    const memory = number(
      telemetry.memory_used_percent ??
      telemetry.memory_usage ??
      telemetry.memory ??
      telemetry.memory_percent,
      0
    );

    const disk = number(
      telemetry.disk_used_percent ??
      telemetry.disk_usage ??
      telemetry.disk ??
      telemetry.disk_percent,
      0
    );

    const alerts = extractAlerts(
      state.intelligence
    );

    const securityAttention =
      securityHasAttention(
        state.security
      );

    const attention =
      alerts.length > 0 ||
      securityAttention ||
      cpu >= 90 ||
      memory >= 90 ||
      disk >= 90;

    const health =
      calculateHealth(
        cpu,
        memory,
        disk,
        attention
      );

    updateMetric(
      "daemon-live-health",
      health + "/100"
    );

    updateMetric(
      "daemon-live-cpu",
      cpu.toFixed(1) + "%"
    );

    updateMetric(
      "daemon-live-memory",
      memory.toFixed(1) + "%"
    );

    updateMetric(
      "daemon-live-disk",
      disk.toFixed(1) + "%"
    );

    updateTickerPairs(
      "ticker-telemetry",
      "LIVE"
    );

    updateTickerPairs(
      "ticker-cpu",
      cpu.toFixed(1) + "%"
    );

    updateTickerPairs(
      "ticker-memory",
      memory.toFixed(1) + "%"
    );

    updateTickerPairs(
      "ticker-disk",
      disk.toFixed(1) + "%"
    );

    updateTickerPairs(
      "ticker-health",
      health + "/100"
    );

    updateTickerPairs(
      "ticker-security",
      securityAttention ? "attention" : "clear"
    );

    updateTickerPairs(
      "ticker-intelligence",
      alerts.length
        ? alerts.length + " signal" + (alerts.length === 1 ? "" : "s")
        : "watching"
    );

    updateTickerPairs(
      "ticker-history",
      historyItems(state.history).length
        ? historyItems(state.history).length + " records"
        : "tracking"
    );

    const stateText = $("daemon-live-state-text");

    if(stateText){
      stateText.textContent =
        attention ? "ATTENTION" : "LIVE";
    }

    setAttentionVisual(attention);

    updateChart(
      (cpu * .55) +
      (memory * .3) +
      (disk * .15)
    );

    const incident =
      buildIncident(
        alerts,
        cpu,
        memory,
        disk,
        securityAttention
      );

    renderIncident(incident);

    const updated = $("daemon-live-updated");

    if(updated){
      updated.textContent =
        "Updated " +
        new Date().toLocaleTimeString(
          [],
          {
            hour:"numeric",
            minute:"2-digit",
            second:"2-digit"
          }
        );
