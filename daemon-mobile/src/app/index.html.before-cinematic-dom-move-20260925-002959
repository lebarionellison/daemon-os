<script id="daemon-personal-script">
(() => {
  const timeEl=document.getElementById("daemon-local-time");
  const greetingEl=document.getElementById("daemon-greeting");
  const contextEl=document.getElementById("daemon-context");
  const stateEl=document.getElementById("daemon-personal-state");

  function updatePersonal(){
    const now=new Date();
    const hour=now.getHours();

    let greeting="Welcome back.";
    if(hour<12) greeting="Good morning.";
    else if(hour<18) greeting="Good afternoon.";
    else greeting="Good evening.";

    const time=now.toLocaleTimeString([],{
      hour:"numeric",
      minute:"2-digit",
      second:"2-digit"
    });

    const zone=Intl.DateTimeFormat().resolvedOptions().timeZone || "Local time";
    const zoneLabel=zone.replace(/_/g," ").replace(/\//g," / ");

    greetingEl.textContent=greeting;
    timeEl.textContent=time;
    contextEl.textContent="Local context â€¢ "+zoneLabel;
  }

  function updateState(){
    const status=document.getElementById("hero-status");
    if(!status)return;

    const value=(status.textContent||"").trim().toUpperCase();

    if(value==="OFFLINE"){
      stateEl.textContent="OFFLINE";
    }else if(value){
      stateEl.textContent=value;
    }else{
      stateEl.textContent="ONLINE";
    }
  }

  updatePersonal();
  updateState();
  setInterval(updatePersonal,1000);
  setInterval(updateState,3000);
})();
</script>

