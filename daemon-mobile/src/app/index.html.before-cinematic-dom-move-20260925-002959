      config.intelligence_enabled;

    document.getElementById(
      "setting-history"
    ).checked =
      config.history_enabled;

    document.getElementById(
      "setting-history-interval"
    ).value =
      config.history_interval_seconds;

    document.getElementById(
      "setting-cpu-warning"
    ).value =
      config.cpu_warning_percent;

    document.getElementById(
      "setting-cpu-critical"
    ).value =
      config.cpu_critical_percent;

    document.getElementById(
      "setting-memory-warning"
    ).value =
      config.memory_warning_percent;

    document.getElementById(
      "setting-memory-critical"
    ).value =
      config.memory_critical_percent;

    document.getElementById(
      "setting-disk-warning"
    ).value =
      config.disk_warning_percent;

    document.getElementById(
      "setting-disk-critical"
    ).value =
      config.disk_critical_percent;

    status.textContent =
      "Configuration loaded.";

  }catch(error){

    status.textContent =
      "Unable to load configuration.";

    console.error(
      "Daemon config:",
      error
    );
  }
}

async function saveSettings(){

  const button =
    document.getElementById(
      "settings-save"
    );

  const status =
    document.getElementById(
      "settings-status"
    );

  const config = {

    monitoring_enabled:
      document.getElementById(
        "setting-monitoring"
      ).checked,

    intelligence_enabled:
      document.getElementById(
        "setting-intelligence"
      ).checked,

    history_enabled:
      document.getElementById(
        "setting-history"
      ).checked,

    history_interval_seconds:
      Number(
        document.getElementById(
          "setting-history-interval"
        ).value
      ),

    cpu_warning_percent:
      Number(
        document.getElementById(
          "setting-cpu-warning"
        ).value
      ),

    cpu_critical_percent:
      Number(
        document.getElementById(
          "setting-cpu-critical"
        ).value
      ),

    memory_warning_percent:
      Number(
        document.getElementById(
          "setting-memory-warning"
        ).value
      ),

    memory_critical_percent:
      Number(
        document.getElementById(
          "setting-memory-critical"
        ).value
      ),

    disk_warning_percent:
      Number(
        document.getElementById(
          "setting-disk-warning"
        ).value
      ),

    disk_critical_percent:
      Number(
        document.getElementById(
          "setting-disk-critical"
        ).value
      )

  };

  button.disabled = true;

  status.textContent =
    "Saving...";

  try{

    const response =
      await fetch(
        API + "/config",
        {
          method:"PUT",
          headers:{
            "Content-Type":
              "application/json"
          },
          body:
            JSON.stringify(config)
        }
      );

    if(!response.ok){

      let message =
        `HTTP ${response.status}`;

      try{

        const body =
          await response.json();

        message =
          typeof body === "string"
            ? body
            : JSON.stringify(body);

      }catch{}

      throw new Error(message);
    }

    status.textContent =
      "Configuration saved.";

    await refreshDaemon();

  }catch(error){

    status.textContent =
      `Save failed: ${error.message}`;

  }finally{

    button.disabled = false;
  }
}

document.addEventListener(
  "DOMContentLoaded",
  () => {

    document
      .getElementById("settings-save")
      .addEventListener(
        "click",
        saveSettings
      );

    loadSettings();

  }
);

</script>

