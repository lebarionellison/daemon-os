<script id="daemon-security-live-script">
(function(){

  const api =
    window.DAEMON_API_URL ||
    window.DAEMON_API ||
    window.location.origin;

  function set(id,value){
    const el=document.getElementById(id);
    if(el)el.textContent=value;
  }

  function setState(state,attention){
    const el=document.getElementById("daemon-sec-state");
    if(!el)return;

    el.textContent=state;
    el.classList.toggle("attention",!!attention);

    const dots=document.querySelectorAll(
      "#daemon-security-live-ticker .daemon-security-live-dot"
    );

    dots.forEach(dot=>{
      dot.classList.toggle("attention",!!attention);
    });
  }

  function countSecuritySignals(data){
    if(!data)return 0;

    const candidates=[
      data.alerts,
      data.anomalies,
      data.events,
      data.threats,
      data.findings
    ];

    let count=0;

    candidates.forEach(value=>{
      if(Array.isArray(value))count+=value.length;
    });

    if(typeof data.count==="number")count=data.count;

    if(typeof data.events_count==="number"){
      count=data.events_count;
    }

    return count;
  }

  function hasAttention(data){
    if(!data)return false;

    const text=JSON.stringify(data).toLowerCase();

    return (
      text.includes("critical") ||
      text.includes("threat") ||
      text.includes("alert") ||
      text.includes("high") ||
      text.includes("suspicious")
    );
  }

  async function updateSecurity(){

    try{

      const response=await fetch(
        api+"/security",
        {
          cache:"no-store",
          credentials:"include"
        }
      );

      if(!response.ok)throw new Error("security");

      const data=await response.json();

      const attention=hasAttention(data);
      const count=countSecuritySignals(data);

      set("daemon-sec-threat",attention?"REVIEW":"ACTIVE");
      set("daemon-sec-events",String(count));
      set(
        "daemon-sec-anomalies",
        attention ? "ATTENTION" : "MONITORING"
      );

      setState(
        attention ? "ATTENTION" : "CLEAR",
        attention
      );

    }catch{

      set("daemon-sec-threat","MONITORING");
      set("daemon-sec-anomalies","MONITORING");
      setState("LIVE",false);

    }

  }

  updateSecurity();
  setInterval(updateSecurity,5000);

})();
</script>
