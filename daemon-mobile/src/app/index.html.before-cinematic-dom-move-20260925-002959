<script id="daemon-cybox-storytelling-js">
(function(){

  if(document.getElementById("daemon-story-root")){
    return;
  }

  const root = document.createElement("div");
  root.id = "daemon-story-root";

  const hero = document.createElement("section");
  hero.className = "daemon-story-hero";

  hero.innerHTML = `
    <div class="daemon-story-eyebrow">
      AI INFRASTRUCTURE INTELLIGENCE
    </div>

    <h1 class="daemon-story-title">
      Your infrastructure
      <br>
      <span>finally understands itself.</span>
    </h1>

    <p class="daemon-story-subtitle">
      Daemon brings telemetry, security signals, system state,
      performance data and operational intelligence into one
      intelligent production layer.
    </p>

    <div class="daemon-story-actions">

      <a
        class="daemon-story-button primary"
        href="#pricing"
      >
        Start Daemon &mdash; 14 Days Free
      </a>

      <a
        class="daemon-story-button secondary"
        href="#daemon-live-production"
      >
        See Daemon in action
      </a>

    </div>
  `;

  root.appendChild(hero);

  /*
   * -------------------------------------------------------
   * FIND THE EXISTING LIVE PRODUCTION VISUALIZATION.
   * We do not create a replacement dashboard.
   * -------------------------------------------------------
   */

  const candidates =
    Array.from(document.querySelectorAll("section,div"));

  let production = null;

  for(const element of candidates){

    if(
      element.id === "daemon-production-ticker" ||
      element.id === "daemon-story-root"
    ){
      continue;
    }

    const text =
      (element.innerText || "").toUpperCase();

    if(
      text.includes("REAL DASHBOARD") ||
      (
        text.includes("DAEMON INTELLIGENCE") &&
        (
          text.includes("TELEMETRY") ||
          text.includes("MONITORED")
        )
      )
    ){

      if(element.getBoundingClientRect().width > 500){
        production = element;
        break;
      }
    }
  }

  if(production){

    production.id = "daemon-live-production";
    production.classList.add("daemon-real-product");

    const showcase =
      document.createElement("section");

    showcase.className =
      "daemon-story-showcase";

    showcase.innerHTML = `
      <div class="daemon-story-showcase-heading">

        <div>
          <div class="daemon-story-showcase-kicker">
            LIVE PRODUCTION
          </div>

          <div class="daemon-story-showcase-title">
            See Daemon in action.
          </div>
        </div>

        <p class="daemon-story-showcase-copy">
          Real production state, monitored continuously.
          The visualization below is the actual Daemon
          intelligence surface &mdash; not a marketing mockup.
        </p>

      </div>
    `;

    production.parentNode.insertBefore(
      showcase,
      production
    );

    showcase.appendChild(production);

    root.appendChild(showcase);

  }

  /*
   * Insert the new story directly after the showcase.
   */
  const main = document.querySelector("main");

  if(main){

    main.insertBefore(
      root,
      main.firstElementChild
    );

  }else{

    document.body.insertBefore(
      root,
      document.body.firstElementChild
    );

  }

  /*
   * -------------------------------------------------------
   * PROBLEM
   * -------------------------------------------------------
   */

  const problem =
    document.createElement("section");

  problem.className =
    "daemon-story-section";

  problem.innerHTML = `
    <div class="daemon-story-section-header">

      <div class="daemon-story-label">
        THE PROBLEM
      </div>

      <h2 class="daemon-story-heading">
        Production infrastructure
        is becoming harder to understand.
      </h2>

    </div>

    <div class="daemon-problem-layout">

      <div class="daemon-problem-large">
        More telemetry does not automatically
        create more understanding.
      </div>

      <div class="daemon-problem-copy">
        Kubernetes, cloud, bare-metal, virtualization,
        distributed systems and AI infrastructure generate
        enormous amounts of telemetry and operational data.
        Engineers still have to connect the dots between
        what changed, why it changed and whether it matters.

        <br><br>

        Daemon is designed to become the intelligence layer
        between those signals and the people responsible
        for the systems.
      </div>

    </div>
  `;

  const insertionPoint =
    document.getElementById("daemon-live-production");

  if(insertionPoint && insertionPoint.parentNode){

    insertionPoint.parentNode.parentNode.insertBefore(
      problem,
      insertionPoint.parentNode.nextSibling
    );

  }else if(main){

    main.appendChild(problem);

  }

  /*
   * -------------------------------------------------------
   * CAPABILITIES
   * -------------------------------------------------------
   */

  const capabilities =
    document.createElement("section");

  capabilities.className =
    "daemon-story-section";

  capabilities.innerHTML = `
    <div class="daemon-story-section-header">

      <div class="daemon-story-label">
        CORE CAPABILITIES
      </div>

      <h2 class="daemon-story-heading">
        One intelligence layer
        for your infrastructure.
      </h2>

      <p class="daemon-story-description">
        Daemon connects the signals engineers already have
        and turns them into operational context.
      </p>

    </div>

    <div class="daemon-capabilities">

      <article class="daemon-capability">

        <div class="daemon-capability-number">
          01
        </div>

        <h3>
          Infrastructure Intelligence
        </h3>

        <p>
          Understand current system state across cloud,
          Kubernetes, bare-metal, distributed and AI
          infrastructure.
        </p>

      </article>

      <article class="daemon-capability">

        <div class="daemon-capability-number">
          02
        </div>

        <h3>
          Operational Intelligence
        </h3>

        <p>
          Correlate telemetry, changes, performance signals
          and historical state to surface what actually
          deserves attention.
        </p>

      </article>

      <article class="daemon-capability">

        <div class="daemon-capability-number">
          03
        </div>

        <h3>
          Security Intelligence
        </h3>

        <p>
          Put security signals into infrastructure context
          so engineers can understand system risk alongside
          system state.
        </p>

      </article>

    </div>
  `;

  if(problem.parentNode){

    problem.parentNode.insertBefore(
      capabilities,
      problem.nextSibling
    );

  }

  /*
   * -------------------------------------------------------
   * HOW IT WORKS
   * -------------------------------------------------------
   */

  const how =
    document.createElement("section");

  how.className =
    "daemon-story-section";

  how.innerHTML = `
    <div class="daemon-story-section-header">

      <div class="daemon-story-label">
        HOW IT WORKS
      </div>

      <h2 class="daemon-story-heading">
        From signal to understanding.
      </h2>

    </div>

    <div class="daemon-how">

      <article class="daemon-how-step">

        <div class="daemon-how-number">
          01
        </div>

        <h3>
          Connect
        </h3>

        <p>
          Bring Daemon alongside the infrastructure and
          observability tools your team already uses.
        </p>

      </article>

      <article class="daemon-how-step">

        <div class="daemon-how-number">
          02
        </div>

        <h3>
          Understand
        </h3>

        <p>
          Daemon evaluates system state, telemetry,
          security signals and operational changes together.
        </p>

      </article>

      <article class="daemon-how-step">

        <div class="daemon-how-number">
          03
        </div>

        <h3>
          Act
        </h3>

        <p>
          Surface meaningful changes, anomalies and
          intelligence so engineers know where attention
          is needed.
        </p>

      </article>

    </div>
  `;

  if(capabilities.parentNode){

    capabilities.parentNode.insertBefore(
      how,
      capabilities.nextSibling
    );

  }

  /*
   * -------------------------------------------------------
   * OUTCOME
   * -------------------------------------------------------
   */

  const outcome =
    document.createElement("section");

  outcome.className =
    "daemon-outcome daemon-story-section";

  outcome.innerHTML = `
    <div class="daemon-story-label">
      WITH DAEMON
    </div>

    <h2 class="daemon-outcome-heading">
      Stop watching infrastructure.
      Start understanding it.
    </h2>

    <p class="daemon-outcome-copy">
      Daemon is building an intelligence layer between
      production systems and the engineers responsible
      for them.
    </p>

    <div class="daemon-outcome-flow">

      <span>TELEMETRY</span>
      <b>&rarr;</b>
      <span>CONTEXT</span>
      <b>&rarr;</b>
      <span>INTELLIGENCE</span>
      <b>&rarr;</b>
      <span>ACTION</span>

    </div>
  `;

  if(how.parentNode){

    how.parentNode.insertBefore(
      outcome,
      how.nextSibling
    );

  }

  /*
   * Existing major Daemon sections become part of the
   * product narrative without replacing their content.
   */
  Array.from(document.querySelectorAll("section")).forEach(
    function(section){

      if(
        section.classList.contains("daemon-story-section") ||
        section.classList.contains("daemon-story-hero") ||
        section.classList.contains("daemon-story-showcase")
      ){
        return;
      }

      const text =
        (section.innerText || "").toUpperCase();

      if(
        text.includes("THE PLATFORM") ||
        text.includes("INFRASTRUCTURE DNA") ||
        text.includes("OPERATIONAL INTELLIGENCE") ||
        text.includes("CONTROL PLANE")
      ){

        section.classList.add("daemon-existing-story");
      }

    }
  );

})();
</script>

